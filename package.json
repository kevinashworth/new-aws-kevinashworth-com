{
  "name": "kevinashworth.com",
  "version": "2.3.15",
  "private": true,
  "description": "My website, as powered by Astro",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:astro": "astro check",
    "check:spell": "npx cspell --config .cspell.json --no-progress --show-suggestions --relative .",
    "check:types": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "npm run format:oxc",
    "fmt:check": "npm run format:oxc:check",
    "format": "npm run format:oxc && npm run format:prettier",
    "format:check": "npm run format:oxc:check && npm run format:prettier:check",
    "format:oxc": "oxfmt --ignore-path .gitignore .",
    "format:oxc:check": "oxfmt --check --ignore-path .gitignore .",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check .",
    "knip": "knip",
    "version:patch": "./bump-version.sh patch",
    "version:minor": "./bump-version.sh minor",
    "version:major": "./bump-version.sh major"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/react": "7.1.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.13",
    "astro-icon": "1.2.0",
    "astro-pagefind": "2.0.1",
    "clsx": "2.1.1",
    "limax": "4.2.3",
    "lodash.merge": "4.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tippy.js": "6.3.7",
    "unpic": "4.2.2"
  },
  "devDependencies": {
    "@astrojs/mdx": "8.1.6",
    "@iconify-json/tabler": "1.2.47",
    "@shikijs/transformers": "4.6.0",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@types/js-yaml": "4.0.9",
    "@types/lodash.merge": "4.6.9",
    "@types/node": "25.6.0",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "js-yaml": "5.5.0",
    "knip": "6.48.0",
    "mdast-util-to-string": "4.0.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "reading-time": "1.5.0",
    "sass": "1.108.2",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=18.14.1"
  }
}
