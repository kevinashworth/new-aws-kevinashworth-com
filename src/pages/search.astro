---
import Layout from "~/layouts/PageLayoutSansFooter.astro";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

const metadata = {
  title: "Search",
};
---

<script>
  // Pagefind search works out of the box; this keeps the `q` query param in
  // sync with the search box so searches can be linked and survive reloads.
  const INPUT_SELECTOR = "pagefind-input input.pf-input";

  function syncUrl(value: string) {
    const url = new URL(window.location.href);
    if (value) {
      url.searchParams.set("q", value);
    } else {
      url.searchParams.delete("q");
    }
    window.history.replaceState({}, "", url);
  }

  // The clear button and Escape key empty the input without firing an
  // `input` event, so read the value after any of these interactions.
  function syncFromInput() {
    setTimeout(() => {
      const input = document.querySelector<HTMLInputElement>(INPUT_SELECTOR);
      if (input) syncUrl(input.value);
    });
  }

  async function onPageLoad() {
    const host = document.querySelector("pagefind-input");
    if (!host || host.hasAttribute("data-q-sync")) return;
    host.setAttribute("data-q-sync", "");

    host.addEventListener("input", syncFromInput);
    host.addEventListener("click", syncFromInput);
    host.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Escape") syncFromInput();
    });

    const query = new URLSearchParams(window.location.search).get("q");
    if (!query) return;
    await customElements.whenDefined("pagefind-input");
    // The input is rendered once the element connects; wait a frame for it.
    await new Promise(requestAnimationFrame);
    const input = document.querySelector<HTMLInputElement>(INPUT_SELECTOR);
    if (input) {
      input.value = query;
      input.dispatchEvent(new Event("input", { bubbles: true }));
    }
  }

  document.addEventListener("astro:page-load", onPageLoad);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", onPageLoad);
  } else {
    onPageLoad();
  }
</script>

<style is:global>
  /* Follow the site's `.dark` class (Pagefind's own hook is data-pf-theme). */
  .search-pagefind {
    --pf-font: inherit;
    --pf-input-height: 52px;
  }
  /* Pagefind clips excerpts to one line; let them wrap to show the full
     excerpt-length of context. Matches Pagefind's specificity boost. */
  :is(*, #\#):is(*, #\#):is(*, #\#) .search-pagefind .pf-result-excerpt,
  :is(*, #\#):is(*, #\#):is(*, #\#) .search-pagefind .pf-heading-excerpt {
    white-space: normal;
    overflow: visible;
  }
  .dark .search-pagefind {
    --pf-text: #e5e5e5;
    --pf-text-secondary: #a0a0a0;
    --pf-text-muted: #949494;
    --pf-background: transparent;
    --pf-border: #333;
    --pf-border-focus: #555;
    --pf-skeleton: #2a2a2a;
    --pf-skeleton-shine: #333;
    --pf-hover: #252525;
    --pf-mark: #e5e5e5;
    --pf-scroll-shadow: rgba(255, 255, 255, 0.1);
    --pf-outline-focus: #58a6ff;
    --pf-error-bg: #2a1a1a;
    --pf-error-border: #5c2828;
    --pf-error-text: #f87171;
    --pf-error-text-secondary: #ef4444;
  }
</style>

<Layout metadata={metadata} disablePagefind={true}>
  <section class="not-prose">
    <div class="mx-auto max-w-xl px-4 py-6 md:px-6">
      <div class="mx-auto text-center">
        <p class="text-secondary text-base font-bold tracking-wide uppercase dark:text-red-200">Search</p>
        <h1 class="leading-tighter font-heading mb-4 text-3xl font-bold tracking-tighter dark:text-gray-200">
          search my site
        </h1>
      </div>
      <div class="mx-auto mb-12 min-h-48">
        <PagefindConfig excerpt-length={50} />
        <div class="search-pagefind flex flex-col gap-4">
          <pagefind-input placeholder="search my site" autofocus></pagefind-input>
          <pagefind-summary></pagefind-summary>
          <pagefind-results show-images="false" hide-sub-results></pagefind-results>
        </div>
      </div>
    </div>
  </section>
</Layout>
